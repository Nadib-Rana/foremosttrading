model SavedDesign {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  
  userId          String    @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  productId       String    @db.Uuid
  product         Product   @relation(fields: [productId], references: [id])
  
  name            String    // e.g., "My Team Away Kit"
  
  // Storing the entire customization configuration as JSON for flexibility
  // Example: { colors: { body: "#fff", collar: "#000" }, text: { front: "Eagles", backNumber: "10" } }
  configuration   Json
  
  orderItems      OrderItem[] // A saved design can be purchased multiple times
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
}
