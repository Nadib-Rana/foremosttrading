            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"layerElementIds\": [\"jersey_body\", \"body_front\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/layer-groups/{{groupId}}/layers",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "layer-groups", "{{groupId}}", "layers"]
            }
          }
        }
      ]
    },
